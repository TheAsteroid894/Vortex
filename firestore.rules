rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidUser(data) {
      return data.userId is string && data.userId.size() > 0 &&
             data.displayName is string && data.displayName.size() > 0 &&
             data.email is string &&
             data.createdAt is timestamp &&
             (!('username' in data) || data.username is string) &&
             (!('customTag' in data) || data.customTag is string) &&
             (!('bannerColor' in data) || data.bannerColor is string) &&
             (!('photoURL' in data) || data.photoURL is string) &&
             (!('bio' in data) || data.bio is string) &&
             (!('nitroActive' in data) || data.nitroActive is bool) &&
             (!('nitroExpiresAt' in data) || data.nitroExpiresAt is number) &&
             (!('gradColor1' in data) || data.gradColor1 is string) &&
             (!('gradColor2' in data) || data.gradColor2 is string) &&
             (!('gradAngle' in data) || data.gradAngle is string) &&
             (!('customGradient' in data) || data.customGradient is string) &&
             (!('theme' in data) || data.theme is string) &&
             (!('serverIds' in data) || data.serverIds is list) &&
             (!('lowBandwidthMode' in data) || data.lowBandwidthMode is bool) &&
             (!('audioBitrateKbps' in data) || data.audioBitrateKbps is number);
    }

    function isValidServer(data) {
      return data.ownerId is string && data.ownerId.size() > 0 &&
             data.name is string && data.name.size() > 0 &&
             data.inviteCode is string && data.inviteCode.size() > 0 &&
             data.memberIds is list && data.memberIds.size() > 0 &&
             data.createdAt is timestamp &&
             (!('description' in data) || data.description is string) &&
             (!('iconUrl' in data) || data.iconUrl is string) &&
             (!('bannerUrl' in data) || data.bannerUrl is string) &&
             (!('boostLevel' in data) || data.boostLevel is number) &&
             (!('emoji' in data) || data.emoji is string) &&
             (!('roles' in data) || data.roles is list) &&
             (!('members' in data) || data.members is list) &&
             (!('bannedUserIds' in data) || data.bannedUserIds is list) &&
             (!('mutedUserIds' in data) || data.mutedUserIds is list) &&
             (!('safetySettings' in data) || data.safetySettings is map) &&
             (!('auditLogs' in data) || data.auditLogs is list);
    }

    function isValidChannel(data) {
      return data.serverId is string && data.serverId.size() > 0 &&
             data.name is string && data.name.size() > 0 &&
             data.type in ['TEXT', 'VOICE', 'VIDEO'] &&
             data.createdAt is timestamp &&
             (!('topic' in data) || data.topic is string) &&
             (!('isEncrypted' in data) || data.isEncrypted is bool) &&
             (!('bitrateKbps' in data) || data.bitrateKbps is number);
    }

    function isValidMessage(data) {
      return data.serverId is string && data.serverId.size() > 0 &&
             data.channelId is string && data.channelId.size() > 0 &&
             data.senderId is string && data.senderId.size() > 0 &&
             data.senderName is string &&
             data.content is string &&
             data.createdAt is timestamp &&
             (!('senderAvatar' in data) || data.senderAvatar is string) &&
             (!('senderPhotoURL' in data) || data.senderPhotoURL is string) &&
             (!('isEncrypted' in data) || data.isEncrypted is bool) &&
             (!('attachments' in data) || data.attachments is list) &&
             (!('reactions' in data) || data.reactions is list) &&
             (!('isPinned' in data) || data.isPinned is bool);
    }

    function isValidVoiceSession(data) {
      return data.channelId is string && data.channelId.size() > 0 &&
             data.serverId is string && data.serverId.size() > 0 &&
             data.updatedAt is timestamp &&
             (!('activeParticipants' in data) || data.activeParticipants is list);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Servers collection
    match /servers/{serverId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                      request.auth.uid == request.resource.data.ownerId &&
                      request.auth.uid in request.resource.data.memberIds &&
                      isValidServer(request.resource.data);
      allow update: if isAuthenticated() &&
                      (request.auth.uid == resource.data.ownerId ||
                       request.auth.uid in resource.data.memberIds ||
                       request.auth.uid in request.resource.data.memberIds) &&
                      isValidServer(request.resource.data);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerId;

      // Channels subcollection
      match /channels/{channelId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidChannel(request.resource.data);
        allow update: if isAuthenticated() && isValidChannel(request.resource.data);
        allow delete: if isAuthenticated();

        // Messages subcollection
        match /messages/{messageId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() &&
                          request.auth.uid == request.resource.data.senderId &&
                          isValidMessage(request.resource.data);
          allow update: if isAuthenticated() &&
                          (request.auth.uid == resource.data.senderId ||
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) &&
                          isValidMessage(request.resource.data);
          allow delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
        }
      }
    }

    // Voice Sessions
    match /voice_sessions/{channelId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidVoiceSession(request.resource.data);
      allow delete: if isAuthenticated();
    }
  }
}
